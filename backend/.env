# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Configuration
MONGODB_URI=mongodb://127.0.0.1:27017/CareerPrep

# JWT Configuration
JWT_SECRET=careerprep_secret_key_2024
JWT_EXPIRE=7d

# OpenAI API Configuration (Required for AI analysis)
OPENAI_API_KEY=your_openai_api_key_here

# JSearch API Configuration (RapidAPI - Required for internships)
JSEARCH_API_KEY=your_rapidapi_jsearch_key_here

# Adzuna API Configuration
ADZUNA_APP_ID=your_adzuna_app_id_here
ADZUNA_API_KEY=your_adzuna_api_key_here

# Jooble API Configuration  
JOOBLE_API_KEY=your_jooble_api_key_here

# File Upload Configuration
MAX_FILE_SIZE=5242880
UPLOAD_DIR=./uploads/resumes

# CORS Configuration
FRONTEND_URL=http://localhost:5173
